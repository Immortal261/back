# Скопируйте этот файл в .env и заполните реальными значениями

PORT=3000

# Название магазина, показывается в шапке и в чеках/письмах
SHOP_NAME="FlexarPPF"
SHOP_PHONE="+7 700 000 00 00"
SHOP_CITY="Алматы"

# --- Администратор (для входа в /admin) ---
# Если оставить пустым — при первом запуске сервер сам создаст пользователя
# "admin" со случайным паролем и один раз покажет его в консоли (сохраните!).
# Чтобы задать свои значения заранее — впишите их сюда ДО первого запуска.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Kaspi Pay ---
# Ваша постоянная ссылка на оплату (одна для всех заказов — клиент сам
# вводит точную сумму в приложении Kaspi). Как получить: в приложении
# Kaspi.kz -> "Работа с Kaspi Pay" / "Приём платежей" -> создать ссылку
# для приёма оплаты на ваш счёт ИП (без указания фиксированной суммы).
# Пока поле пустое — сайт работает в ДЕМО-режиме: заказ создаётся, но
# клиенту нужно будет выставить счёт вручную.
KASPI_PAYMENT_LINK=

# --- Банковские карты (эквайринг) ---
# Заполняется после подключения агрегатора карточных платежей
# (например Epay/Halyk, CloudPayments, PayBox — выбирайте по своим условиям).
# Пока пусто — сайт также работает в ДЕМО-режиме.
CARD_PROVIDER=
CARD_API_KEY=
CARD_API_SECRET=
